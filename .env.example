# ── LLM 키 (서버만 읽고 브라우저로는 보내지 않는다) ─────────────
# 둘 중 하나만 넣으면 된다. 둘 다 있으면 Claude 우선. DeepSeek 만 쓰려면 ANTHROPIC_API_KEY 는 비워 둔다.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# DeepSeek 모델 (기본 deepseek-chat)
DEEPSEEK_MODEL=

# ── 구글 로그인 · 드라이브 동기화 ─────────────────────────────
# 비워 두면 로그인·동기화가 꺼지고 레시피는 이 브라우저에만 저장된다.
# 이때 AI API 는 로컬 개발에서만 열리고, 운영(NODE_ENV=production·Vercel)에서는 막힌다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI 기능을 쓸 수 있는 구글 계정 (쉼표로 여러 개)
ALLOWED_EMAILS=
# 로그인 쿠키 서명용 임의 문자열. 예: openssl rand -base64 32
SESSION_SECRET=
# 로그인 콜백 기준 주소. 비우면 요청 주소로 정한다 (로컬 개발은 http://localhost:5173)
APP_ORIGIN=

# 로컬 API 서버 포트 (Vite 가 /api 를 여기로 프록시한다). 배포 환경이 PORT 를 주면 그걸 쓴다
API_PORT=8787

# 허브·레시피노트·노벨벙커·메모노트가 로그인을 함께 쓸 상위 도메인 (예: park-bible.com). 비우면 이 앱에서만 로그인된다.
# 네 앱의 SESSION_SECRET·ALLOWED_EMAILS 도 같아야 한다
COOKIE_DOMAIN=
